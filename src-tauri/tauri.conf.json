{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniChat",
  "version": "0.1.0",
  "identifier": "app.omnichat.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OmniChat",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon-512.png",
      "icons/icon-256.png",
      "icons/icon-128.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "./staged-next/standalone/server.js": "./server.js",
      "./staged-next/standalone/package.json": "./package.json",
      "./staged-next/BUILD_ID": "./BUILD_ID",
      "./staged-next/server/**": "./.next/server",
      "./staged-next/static/**": "./.next/static",
      "../public/*": "./public",
      "../public/icons/*": "./public/icons",
      "./.node-dist/**": "./node",
      "./staged-modules/**": "./node_modules"
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["$APPDATA/**"],
        "deny": ["$APPDATA/*.key", "$APPDATA/*.pem", "$APPDATA/**/secrets/**"]
      }
    },
    "shell": {
      "open": false,
      "scope": []
    },
    "clipboard": {
      "all": false
    },
    "dialog": {
      "all": false
    },
    "notification": {
      "all": false
    }
  }
}
