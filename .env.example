# OmniChat Environment Variables
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────────────────────────
# REQUIRED: Authentication
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Legacy fallback, read only when AUTH_SECRET is absent:
# NEXTAUTH_SECRET=

# Optional: NextAuth URL (defaults to http://localhost:3000)
# NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# REQUIRED: Encryption
# ─────────────────────────────────────────────────────────────
# Used to encrypt API keys at rest (AES-256-GCM)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
ENCRYPTION_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────
# SQLite (default for local development — file is gitignored):
DATABASE_URL="file:./data/omnichat.db"

# PostgreSQL (for production / docker-compose):
# DATABASE_URL="postgresql://user:password@localhost:5432/omnichat"

# ─────────────────────────────────────────────────────────────
# Application Mode
# ─────────────────────────────────────────────────────────────
# Desktop mode (for Tauri app):
# DESKTOP_MODE=true

# Node environment (development/production):
# NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# OAuth Providers (Optional)
# ─────────────────────────────────────────────────────────────
# Google OAuth:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Docker Deployment (if using docker-compose.yml)
# ─────────────────────────────────────────────────────────────
# PostgreSQL credentials (REQUIRED for docker-compose):
# POSTGRES_USER=omnichat
# POSTGRES_PASSWORD=<strong-password-here>
# POSTGRES_DB=omnichat
# DB_PORT=5432
# APP_PORT=3000

# ─────────────────────────────────────────────────────────────
# Security: CSRF Protection
# ─────────────────────────────────────────────────────────────
# Canonical origin for CSRF validation (REQUIRED in production):
# APP_ORIGIN=https://app.example.com

# ─────────────────────────────────────────────────────────────
# Security: Email Verification (opt-in for hosted deployments)
# ─────────────────────────────────────────────────────────────
# EMAIL_VERIFICATION_REQUIRED=true
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Test-only: permit plaintext SMTP against loopback. Never enable in production.
# SMTP_TEST_ALLOW_INSECURE=true

# ─────────────────────────────────────────────────────────────
# Observability: /api/metrics access
# ─────────────────────────────────────────────────────────────
# Scrape with: Authorization: Bearer <METRICS_TOKEN>
# Unset in production => the endpoint answers 404 (fail closed).
# Unset outside production => open, for local debugging only.
# METRICS_TOKEN=

# ─────────────────────────────────────────────────────────────
# Security: Distributed Rate Limiting (opt-in for multi-instance)
# ─────────────────────────────────────────────────────────────
# IMPORTANT: with NODE_ENV=production and RATE_LIMIT_BACKEND unset, the backend
# resolves to redis-rest; without valid Upstash credentials it fails CLOSED and
# sign-in is refused (Auth.js reports it as CredentialsSignin). A single
# instance should state the in-memory limiter explicitly:
# RATE_LIMIT_BACKEND=memory
# Only then does distributed limiting apply:
# RATE_LIMIT_BACKEND=redis-rest
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_PREFIX=omnichat-prod
