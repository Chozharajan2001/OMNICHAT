# OmniChat Environment Variables
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────────────────────────
# REQUIRED: Authentication
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional: NextAuth URL (defaults to http://localhost:3000)
# NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# REQUIRED: Encryption
# ─────────────────────────────────────────────────────────────
# Used to encrypt API keys at rest (AES-256-GCM)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
ENCRYPTION_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────
# SQLite (default for development):
DATABASE_URL="file:./omnichat.db"

# PostgreSQL (for production):
# DATABASE_URL="postgresql://user:password@localhost:5432/omnichat"

# ─────────────────────────────────────────────────────────────
# Application Mode
# ─────────────────────────────────────────────────────────────
# Desktop mode (for Tauri app):
# DESKTOP_MODE=true

# Node environment (development/production):
# NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# OAuth Providers (Optional)
# ─────────────────────────────────────────────────────────────
# Google OAuth:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Docker Deployment (if using docker-compose.yml)
# ─────────────────────────────────────────────────────────────
# PostgreSQL credentials (REQUIRED for docker-compose):
# POSTGRES_USER=omnichat
# POSTGRES_PASSWORD=<strong-password-here>
# POSTGRES_DB=omnichat
# DB_PORT=5432
# APP_PORT=3000
