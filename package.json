{
  "name": "omnichat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "quality:check": "node scripts/quality/check.mjs",
    "quality:baseline": "node scripts/quality/check.mjs --baseline",
    "quality:staged": "node scripts/quality/staged.mjs",
    "quality:test": "node --test scripts/quality/quality.test.mjs",
    "hooks:install": "node scripts/quality/install-hooks.mjs",
    "test": "vitest run",
    "test:ui": "vitest run --project ui",
    "db:generate": "prisma generate",
    "db:init": "node scripts/init-sqlite-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:drift-check": "node scripts/quality/prisma-drift-check.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:macos": "tauri build --target aarch64-apple-darwin",
    "tauri:build:macos-intel": "tauri build --target x86_64-apple-darwin",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:icons": "bash scripts/generate-icons.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/deepseek": "^2.0.20",
    "@ai-sdk/google": "^3.0.29",
    "@ai-sdk/groq": "^3.0.24",
    "@ai-sdk/mistral": "^3.0.20",
    "@ai-sdk/openai": "^3.0.29",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@ai-sdk/perplexity": "^3.0.19",
    "@ai-sdk/react": "^3.0.118",
    "@ai-sdk/xai": "^3.0.57",
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.4.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "ai": "^6.0.86",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libsql": "^0.5.22",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "nodemailer": "^10.0.10",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@prisma/client-runtime-utils": "^7.4.2",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "4.0.18",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.1.1",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}